# RescueLink Mobile – API base URL (.env and/or --dart-define=API_BASE_URL=...)
# No trailing slash. HTTPS required for production.

# Production (Render API, Singapore):
#   API_BASE_URL=https://resquelink-backend.onrender.com
#   flutter build apk --dart-define=API_BASE_URL=https://resquelink-backend.onrender.com

# Android emulator → local backend on host:
#   API_BASE_URL=http://10.0.2.2:3000

# Real device → PC LAN IP:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.5:3000

# iOS simulator:
#   flutter run --dart-define=API_BASE_URL=http://localhost:3000

API_BASE_URL=http://10.0.2.2:3000

RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Dev/test only: skip real GPS and use fixed Dagupan coords on residency check.
# Set false (or omit) for real-device / production builds.
BYPASS_LOCATION_CHECK=false

# OneSignal (same App ID as Backend)
ONESIGNAL_APP_ID=

# reCAPTCHA note:
# Use a reCAPTCHA v2 "I'm not a robot" key pair. In Google admin → Domains, include:
#   localhost
# (Flutter WebView loads the challenge with origin localhost so siteverify accepts the token.)
