# RescueLink Mobile – API base URL
# Used via: flutter run --dart-define=API_BASE_URL=http://HOST:3000
#
# Android emulator (default, no need to set):
#   flutter run
#   → uses http://10.0.2.2:3000
#
# Real device (use your PC’s LAN IP, e.g. 192.168.1.5):
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.5:3000
#
# iOS simulator:
#   flutter run --dart-define=API_BASE_URL=http://localhost:3000

API_BASE_URL=http://10.0.2.2:3000

# Google reCAPTCHA v2 site key (optional for development)
# Default: Google test key (always passes). Production: get keys at https://www.google.com/recaptcha
# flutter run --dart-define=RECAPTCHA_SITE_KEY=your_site_key

RECAPTCHA_SITE_KEY=6Lc-cFssAAAAAO-zuyOOhnMmTC_KqSQkPcO3P5rK
