VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# API base URL (local dev). Production: set VITE_API_URL in Vercel project env before build — not in git.
# Use Render HTTPS origin, no trailing slash. WebSockets derive wss:// from this URL.
VITE_API_URL=http://localhost:3000

# Never set VITE_DEV_MODE in production (bypasses authentication).

# Blockchain feature flag (mirrors USE_BLOCKCHAIN in Backend/.env)
# When false: blockchain UI labels are replaced with audit-trail equivalents.
VITE_USE_BLOCKCHAIN=false

# OneSignal web push (same App ID as Backend)
VITE_ONESIGNAL_APP_ID=
