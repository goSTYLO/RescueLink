    {
      "name": "3. Incident Encryption Tests",
      "item": [
        {
          "name": "3.1 - Create Emergency Incident (Encrypts coordinates & description)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Incident created with encrypted coordinates', function() {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  // API returns DECRYPTED values as numbers",
                  "  pm.expect(typeof body.latitude).to.equal('number');",
                  "  pm.expect(typeof body.longitude).to.equal('number');",
                  "  pm.expect(body.latitude).to.equal(14.5995);",
                  "  pm.expect(body.longitude).to.equal(120.9842);",
                  "  pm.environment.set('incidentId', body.id);",
                  "  console.log('✅ Incident created with ID: ' + body.id);",
                  "  console.log('✅ Coordinates returned as NUMBERS (decrypted)');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 14.5995,\n  \"longitude\": 120.9842,\n  \"description\": \"Traffic accident on EDSA near Megamall\",\n  \"barangay\": \"Barangay San Antonio\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/incidents/emergency",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "incidents", "emergency"]
            }
          }
        },
        {
          "name": "3.2 - Get Incident (Verify Coordinate Decryption)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Incident coordinates are decrypted to numbers', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(typeof body.latitude).to.equal('number');",
                  "  pm.expect(typeof body.longitude).to.equal('number');",
                  "  pm.expect(body.latitude).to.equal(14.5995);",
                  "  pm.expect(body.longitude).to.equal(120.9842);",
                  "  pm.expect(body.description).to.equal('Traffic accident on EDSA near Megamall');",
                  "  console.log('✅ Incident coordinates decrypted correctly');",
                  "});",
                  "",
                  "pm.test('Coordinates are valid geographic ranges', function() {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.latitude).to.be.within(-90, 90);",
                  "  pm.expect(body.longitude).to.be.within(-180, 180);",
                  "  console.log('✅ Coordinates are valid geographic values');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/incidents/{{incidentId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "incidents", "{{incidentId}}"]
            }
          }
        },
        {
          "name": "3.3 - List Incidents (All Decrypted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All incident coordinates decrypted in list view', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  if (body.length > 0) {",
                  "    body.forEach((incident, idx) => {",
                  "      pm.expect(typeof incident.latitude).to.equal('number', `Incident ${idx} latitude not a number`);",
                  "      pm.expect(typeof incident.longitude).to.equal('number', `Incident ${idx} longitude not a number`);",
                  "      pm.expect(incident.latitude).to.be.within(-90, 90);",
                  "      pm.expect(incident.longitude).to.be.within(-180, 180);",
                  "    });",
                  "  }",
                  "  console.log('✅ All ' + body.length + ' incidents decrypted in list');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
