    {
      "name": "2. User Data Encryption Tests",
      "item": [
        {
          "name": "2.1 - Get User Profile (Check Decryption)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User profile decrypted correctly', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.phone_number).to.equal('+639666638967');",
                  "  pm.expect(body.email).to.be.a('string');",
                  "  pm.expect(body.first_name).to.be.a('string');",
                  "  pm.expect(body.last_name).to.be.a('string');",
                  "  pm.expect(body.address).to.be.a('string');",
                  "  console.log('✅ All user PII fields decrypted');",
                  "});",
                  "",
                  "pm.test('No encrypted hex strings in response', function() {",
                  "  const body = pm.response.json();",
                  "  // Phone should be readable, not hex",
                  "  pm.expect(body.phone_number).to.match(/^\\+63/);",
                  "  // Email should have @, not be hex",
                  "  pm.expect(body.email).to.contain('@');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "me"]
            }
          }
