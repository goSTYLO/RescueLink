# Copy to .env and fill in real values. Never commit .env.

# Database connection (local dev). Production (Render): Supabase Postgres URI on DATABASE_URL only.
# NODE_ENV=production enables SSL in src/config/db.js. Prefer direct db.<ref>.supabase.co over pooler for first connect.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rescuelink_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rescuelink_dev

# JWT & Authentication
JWT_SECRET=<generate-random-32-char-string>
JWT_EXPIRE=7d
DISPATCHER_MFA_ENABLED=true

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# IPROG SMS OTP (citizen registration) — server-side only
# Dashboard / docs: https://www.iprogsms.com  |  API: /api/v1/documentation
# Flutter must NEVER receive these values.
# ---------------------------------------------------------------------------
IPROG_API_TOKEN=your_iprog_api_token
# Optional override (default is IPROG production API)
IPROG_API_BASE_URL=https://www.iprogsms.com/api/v1
# OTP lifetime sent to IPROG send_otp (minutes, 1–60; IPROG default is 5)
IPROG_OTP_EXPIRES_IN_MINUTES=5
# Optional custom SMS body; must include :otp placeholder if set
# IPROG_OTP_MESSAGE=Your RescueLink code is :otp. Valid for 5 minutes. Do not share it.

# Local OTP policy (app-side; align with IPROG expiry)
PHONE_OTP_LENGTH=6
PHONE_OTP_EXPIRY=300

# Google reCAPTCHA v2 — SECRET key only (from https://www.google.com/recaptcha/admin).
# Do NOT paste the site key here. Mobile uses RECAPTCHA_SITE_KEY; Backend uses this secret.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# File Upload & Scanning
UPLOAD_DIR=./uploads
QUARANTINE_DIR=./uploads/_quarantine
MAX_FILE_SIZE_AUDIO=52428800
MAX_FILE_SIZE_PHOTO=10485760
MAX_FILE_SIZE_VIDEO=104857600
FILE_SCAN_FAIL_OPEN=true
DEEP_SCAN_TIMEOUT_SECONDS=7200
DEEP_SCAN_MAX_RETRIES=3

# AI Service Integration (local: uvicorn on 8000). Production (Render): HF Space HTTPS origin, no port suffix.
# Example: https://your-user-rescuelink-ai.hf.space
AI_SERVICE_URL=http://localhost:8000
AI_TRANSCRIPTION_TIMEOUT=60000
# Same secret on Render and HF Space when AI_INTERNAL_TOKEN is enforced by the AI service.
# AI_INTERNAL_TOKEN=

# Blockchain Service Integration
BLOCKCHAIN_SERVICE_URL=http://localhost:8001

# CORS (src/app.js reads FRONTEND_URL only — not CORS_ORIGIN).
# Local: leave unset to allow all origins in development, or set one dev dashboard URL.
# Production (Render): exact Vercel origin, e.g. https://your-app.vercel.app (single URL, no comma list).
# FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=900000

# Logging & Environment (production: NODE_ENV=production on Render)
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
