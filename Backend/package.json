{
  "name": "rescue-link-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:unit": "jest tests/duplicateDetection.test.js --detectOpenHandles --forceExit",
    "test:endpoints": "jest tests/endpoints.smoke.test.js --detectOpenHandles --forceExit",
    "test:security": "jest --detectOpenHandles --forceExit tests/aiService.test.js tests/fileScanService.test.js tests/uploadMiddleware.integration.test.js tests/incidentController.security.test.js",
    "test:rbac": "jest tests/rbac.test.js --detectOpenHandles --forceExit",
    "test:integration": "jest tests/location.integration.test.js tests/department.integration.test.js --detectOpenHandles --forceExit",
    "test:ws": "jest tests/websocket.integration.test.js --runInBand --detectOpenHandles --forceExit",
    "test:all": "npm run test:rbac && npm run test:security && npm run test:endpoints && npm run test:integration",
    "test:storage": "jest tests/storageIntegration.test.js --detectOpenHandles --forceExit",
    "check:storage": "node scripts/check-storage-connection.js",
    "check:storage:roundtrip": "node scripts/check-storage-connection.js --round-trip",
    "setup-db": "node setup-db.js",
    "migrate": "node migrations/run_migrations.js",
    "seed-db": "node scripts/seed-db.js",
    "seed-incidents": "node scripts/seed-incidents-from-audio.js",
    "analyze-duplicates": "node scripts/run-duplicate-analysis.js",
    "link-seed-duplicates": "node scripts/link-seed-duplicates.js",
    "reclassify-incidents": "node scripts/reclassify-all-incidents.js",
    "seed-db:full": "npm run seed-db && npm run seed-incidents -- --reset",
    "backup-db": "node scripts/backup-db.js"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.2",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^13.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "pg": "^8.11.2",
    "sharp": "^0.34.4",
    "@supabase/supabase-js": "^2.49.8",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
