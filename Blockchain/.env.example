# Ganache connection (default: http://127.0.0.1:8545, Desktop uses 7545)
GANACHE_URL=http://127.0.0.1:7545

# First Ganache account private key (from Ganache UI or CLI)
PRIVATE_KEY=your_ganache_private_key_here

# Ganache chain ID (default: 1337, Desktop uses 5777)
CHAIN_ID=5777

# Optional: set after first run to avoid redeploying each time
CONTRACT_ADDRESS=

# Gas optimization tests (optional)
# BLOCKCHAIN_SERVICE_URL=http://localhost:8001
# BACKEND_URL=http://localhost:3000
# TEST_AUTH_TOKEN=     # JWT for E2E Backend verify test
# TEST_INCIDENT_ID=    # Existing incident ID for E2E test
