# Ganache connection (default: http://127.0.0.1:8545, Desktop uses 7545)
GANACHE_URL=http://127.0.0.1:7545

# First Ganache account private key (from Ganache UI or CLI)
PRIVATE_KEY=0x5a449385cfa10179cb29abb5901879594a8042e02b8f6ac468fe9dcf3378f408

# Ganache chain ID (default: 1337, Desktop uses 5777)
CHAIN_ID=5777

# Optional: set after first run to avoid redeploying each time
CONTRACT_ADDRESS=
