# Hugging Face Space / Inference API
# HF Space secrets (Settings → Repository secrets): AI_INTERNAL_TOKEN (match Render), ENVIRONMENT=production.
# Before the Space can route traffic, README needs Docker front matter (sdk: docker, app_port: 7860) + Dockerfile — see Documentation/backend/DEPLOYMENT.md.
# HF_API_TOKEN: only if STT uses HF Inference API fallback (https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_YOUR_TOKEN_HERE

# STT Provider Settings
# local = Faster-Whisper quantized local inference (default)
# api = HF Inference API only
# auto = prefer local then fallback to API when enabled
STT_PROVIDER=local
STT_ENABLE_API_FALLBACK=true
# On small CPU Spaces use tiny or base; medium + classifier often exceeds free-tier RAM.
STT_LOCAL_MODEL_SIZE=medium
STT_MODEL_PATH=
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_CPU_THREADS=
STT_BEAM_SIZE=5
STT_CACHE_DIR=

# Audio Settings
MAX_AUDIO_DURATION_SECONDS=60
MIN_AUDIO_DURATION_SECONDS=5
MAX_AUDIO_FILE_SIZE_MB=25
WHISPER_CONFIDENCE_THRESHOLD=0.7

# Whisper Model
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo

# Environment (production Space: ENVIRONMENT=production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend-to-AI auth: set the same value on Render (AI_INTERNAL_TOKEN) and this Space.
AI_INTERNAL_TOKEN=

# Classification safety controls
AI_MAX_TEXT_LENGTH=4000
AI_LOW_CONFIDENCE_THRESHOLD=0.7
