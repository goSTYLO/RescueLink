# =============================================================================
# RescueLink AI — Environment Configuration
# Restart the service after changes: uvicorn api.main:app --reload
# =============================================================================

# -----------------------------------------------------------------------------
# Hugging Face Inference API (STT API fallback only)
# Get your token from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_API_TOKEN=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

# -----------------------------------------------------------------------------
# Speech-to-Text (Whisper / Faster-Whisper)
# -----------------------------------------------------------------------------
# Provider: local | api | auto
#   local = Faster-Whisper on this machine (default)
#   api   = Hugging Face Inference API only (uses WHISPER_MODEL_ID)
#   auto  = local first, optional API fallback when enabled
STT_PROVIDER=local
STT_ENABLE_API_FALLBACK=true

# Local model: tiny | base | small | medium | large-v3 | large-v3-turbo
# Or set STT_MODEL_PATH to a custom on-disk model directory
STT_LOCAL_MODEL_SIZE=medium
STT_MODEL_PATH=

# Runtime: auto picks CUDA when available; compute auto = int8 (CPU) / int8_float16 (GPU)
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_CPU_THREADS=
STT_BEAM_SIZE=5
STT_CACHE_DIR=

# HF API fallback model (when STT_PROVIDER=api or fallback is triggered)
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo

# Audio input constraints
MAX_AUDIO_DURATION_SECONDS=60
MIN_AUDIO_DURATION_SECONDS=5
MAX_AUDIO_FILE_SIZE_MB=25

# Flags low-confidence *classification* on audio endpoints (not STT word accuracy)
WHISPER_CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Emergency Classification (XLM-RoBERTa)
# -----------------------------------------------------------------------------
# Weights: models/emergency_model.pt
# Metadata: models/label_meta.json (backbone: xlm-roberta-base, calibrated threshold: 0.64)
# Per-request threshold on /classify and /v1/classify-audio defaults to 0.5 (query/body param)

AI_MAX_TEXT_LENGTH=4000
AI_LOW_CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Service Security
# -----------------------------------------------------------------------------
# Shared secret for Backend → AI calls (header: x-ai-service-token)
AI_INTERNAL_TOKEN=

# -----------------------------------------------------------------------------
# Startup Performance
# -----------------------------------------------------------------------------
AI_STARTUP_WARMUP=true
AI_STARTUP_WARMUP_WHISPER=true

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
